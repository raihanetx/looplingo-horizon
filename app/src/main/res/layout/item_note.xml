<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_note_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_note_card">

    <!-- Note text — slate_600, 14sp, line height 21sp -->
    <TextView
        android:id="@+id/tv_note_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/colorOnSurface"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.5"
        android:fontFamily="sans-serif"
        tools:text="Important vocabulary from this section" />

    <!-- Edit + Delete buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Edit button -->
        <ImageView
            android:id="@+id/iv_note_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:contentDescription="Edit note"
            android:src="@drawable/ic_edit"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Delete button -->
        <ImageView
            android:id="@+id/iv_note_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:scaleType="centerInside"
            android:contentDescription="Delete note"
            android:src="@drawable/ic_delete"
            android:tint="@color/colorOnSurfaceVariant"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
