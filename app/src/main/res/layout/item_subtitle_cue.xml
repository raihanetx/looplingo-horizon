<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_cue_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="16dp"
    android:paddingHorizontal="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <!-- Row 1: English with inline timestamp [MM:SS] -->
    <TextView
        android:id="@+id/tv_cue_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#A1A1AA"
        tools:text="[0:20]  Hello, how are you today?" />

    <!-- Spacer 6dp -->
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <!-- Row 2: Bangla Translation -->
    <TextView
        android:id="@+id/tv_cue_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#A1A1AA"
        android:visibility="gone"
        tools:text="হ্যালো, আজ কেমন আছেন?"
        tools:visibility="visible" />

    <!-- Hidden timestamp (used by adapter) -->
    <TextView
        android:id="@+id/tv_cue_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
