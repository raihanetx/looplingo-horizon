<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_cue_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="@dimen/space_md"
    android:paddingHorizontal="@dimen/space_lg"
    android:layout_marginVertical="@dimen/space_xs"
    android:background="@drawable/bg_dialogue_item"
    android:clickable="true"
    android:focusable="true">

    <!-- English: [timestamp] text -->
    <TextView
        android:id="@+id/tv_cue_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
        android:textColor="@color/colorOnSurfaceVariant"
        tools:text="[0:20] Hello, how are you today?" />

    <!-- Bangla translation -->
    <TextView
        android:id="@+id/tv_cue_translation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
        android:textColor="@color/colorPrimary"
        android:visibility="gone"
        tools:text="হ্যালো, আজ কেমন আছেন?"
        tools:visibility="visible" />

    <!-- Hidden timestamp (used by adapter, not displayed separately) -->
    <TextView
        android:id="@+id/tv_cue_timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
