<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_cue_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_sm"
    android:paddingHorizontal="@dimen/space_lg"
    android:layout_marginVertical="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true">

    <!-- Timestamp + text row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_cue_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
            android:textColor="@color/colorOnSurfaceVariant"
            android:minWidth="48dp"
            tools:text="0:20" />

        <TextView
            android:id="@+id/tv_cue_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
            tools:text="Hello, how are you today?" />

    </LinearLayout>

    <!-- Translation text -->
    <TextView
        android:id="@+id/tv_cue_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginStart="56dp"
        android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
        android:textColor="@color/colorPrimary"
        android:visibility="gone"
        tools:text="হ্যালো, আজ কেমন আছেন?"
        tools:visibility="visible" />

</LinearLayout>
