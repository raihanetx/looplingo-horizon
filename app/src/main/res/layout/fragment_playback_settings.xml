<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizon Loop — Now Playing Screen (v6 Tab-Based Redesign)
    Structure matches user's physical device wireframe:
      ┌──────────────────────────────────────────┐
      │  HEADER BLOCK (48px)                     │
      │  [Avatar] Track Info    [Loop] [Speed]   │
      ├──────────────────────────────────────────┤
      │  MAIN DISPLAY AREA (flex-1)              │
      │  - Clean View Panel                      │
      │  - Talk Panel (dialogue list)            │
      │  - Loop Panel (A-B controls + templates) │
      │  - Notes Panel (saved timestamps)        │
      ├──────────────────────────────────────────┤
      │  TAB NAVIGATION PILL (52px)              │
      │  [Clean] [Talk] [Loop] [Notes]           │
      ├──────────────────────────────────────────┤
      │  PLAYER FOOTER CARD (180px)              │
      │  [Track Title & Subtitle]                │
      │  [Elapsed] |I|I|I|I| [Total]             │
      │            Waveform SeekBar              │
      │  [Rewind]   [Play]   [Forward]           │
      └──────────────────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER — profile icon + name + speed | secondary: app name + plan
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg">

        <!-- Profile avatar icon -->
        <ImageView
            android:id="@+id/iv_header_avatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:contentDescription="@string/content_desc_video_icon"
            android:scaleType="centerInside"
            android:background="@drawable/bg_profile_avatar"
            app:srcCompat="@drawable/ic_person"
            app:tint="@color/colorOnPrimary"
            android:clickable="true"
            android:focusable="true" />

        <!-- Name + Plan column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raihan"
                android:textAppearance="@style/TextAppearance.Horizon.TitleSmall"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/tv_header_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horizon loop | pro plan"
                android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Send button — triggers subtitle generation -->
        <ImageView
            android:id="@+id/iv_send_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:padding="@dimen/space_xs"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/colorOnSurface" />

        <!-- Divider between send and speed -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/space_sm"
            android:background="@color/colorOutlineVariant" />

        <!-- Speed indicator -->
        <TextView
            android:id="@+id/tv_header_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textAppearance="@style/TextAppearance.Horizon.TitleSmall"
            android:textColor="@color/colorOnSurface"
            android:clickable="true"
            android:focusable="true" />

        <!-- Divider between speed and audio mode -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="@dimen/space_sm"
            android:background="@color/colorOutlineVariant" />

        <!-- Audio mode toggle — text only -->
        <TextView
            android:id="@+id/tv_audio_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio"
            android:textAppearance="@style/TextAppearance.Horizon.TitleSmall"
            android:textColor="@color/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN DISPLAY AREA (flex-1) — Switchable panels via tab navigation
         ═══════════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/layout_main_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ══════ PANEL: CLEAN VIEW ══════ -->
        <!-- Minimal view — shows current track info, waveform visualization, no clutter -->
        <LinearLayout
            android:id="@+id/panel_clean"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_xl"
            android:visibility="visible">

            <!-- App logo (shown when no subtitles loaded) -->
            <ImageView
                android:id="@+id/iv_clean_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="App logo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:id="@+id/tv_clean_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineMedium"
                android:textColor="@color/colorOnSurface"
                tools:text="Chapter 03" />

            <!-- Processing state (shown during subtitle generation) -->
            <LinearLayout
                android:id="@+id/layout_processing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Processing..."
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- English dialogue (shown when subtitles active) -->
            <TextView
                android:id="@+id/tv_clean_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorOnSurface"
                android:visibility="gone"
                tools:text="Hello, how are you today?" />

            <!-- Bangla translation (shown when subtitles active) — same size as English -->
            <TextView
                android:id="@+id/tv_clean_bangla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                tools:text="হ্যালো, আজ কেমন আছেন?" />

        </LinearLayout>

        <!-- ══════ PANEL: TALK (Dialogue List) ═══════════════════════════════ -->
        <!-- Shows only the dialogue segments list -->
        <FrameLayout
            android:id="@+id/panel_talk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dialogue_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="72dp"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/item_subtitle_cue" />

            <!-- Empty state for Talk panel -->
            <LinearLayout
                android:id="@+id/layout_talk_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.3"
                    android:contentDescription="Dialogue"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_talk"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/no_dialogue_yet"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Play Selected button (shown when items are selected) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_selected"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="Play Selected"
                android:textSize="13sp"
                android:visibility="gone"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:cornerRadius="22dp"
                style="@style/Widget.MaterialComponents.Button" />

        </FrameLayout>

        <!-- ══════ PROGRESS OVERLAY (visible during subtitle generation) ══════ -->
        <LinearLayout
            android:id="@+id/layout_progress_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/colorBackground"
            android:paddingHorizontal="@dimen/space_xl"
            android:visibility="gone">

            <!-- Step icon -->
            <ImageView
                android:id="@+id/iv_progress_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.8"
                android:contentDescription="Progress"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_audio_track"
                app:tint="@color/colorPrimary" />

            <!-- Main step text -->
            <TextView
                android:id="@+id/tv_progress_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="Preparing..."
                android:textAppearance="@style/TextAppearance.Horizon.TitleMedium"
                android:textColor="@color/colorOnSurface" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progress_bar_generation"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/colorPrimary"
                android:progressBackgroundTint="@color/colorSurfaceVariant"
                android:indeterminate="false" />

            <!-- Sub-step detail text -->
            <TextView
                android:id="@+id/tv_progress_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text=""
                android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                android:textColor="@color/colorOnSurfaceVariant" />

            <!-- Percentage text -->
            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="0%"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorPrimary" />

            <!-- In-app process log (scrollable, copyable) -->
            <ScrollView
                android:id="@+id/scroll_process_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@color/colorSurfaceVariant"
                android:padding="@dimen/space_sm"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_process_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>

            <!-- Copy log button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="COPY LOG"
                android:textSize="11sp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <!-- ══════ PANEL: LOOP (Saved Loops + Add Loop FAB) ═════════════════ -->
        <LinearLayout
            android:id="@+id/panel_loop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Add loop form — compact single-line input (at top, always visible) -->
            <LinearLayout
                android:id="@+id/layout_add_loop_form"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:background="@drawable/bg_compact_form">

                <!-- Loop name -->
                <EditText
                    android:id="@+id/et_loop_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@null"
                    android:hint="Name"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/colorOutlineVariant" />

                <!-- Start time -->
                <EditText
                    android:id="@+id/et_loop_start"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:background="@null"
                    android:hint="0:00"
                    android:text="0:00"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/colorOutlineVariant" />

                <!-- End time -->
                <EditText
                    android:id="@+id/et_loop_end"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:background="@null"
                    android:hint="End"
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="@color/colorOutlineVariant" />

                <!-- Loop count -->
                <EditText
                    android:id="@+id/et_loop_count"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:background="@null"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:importantForAutofill="no" />

                <!-- Preview icon -->
                <ImageView
                    android:id="@+id/btn_loop_preview"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Preview"
                    android:src="@drawable/ic_play"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Save/Add icon -->
                <ImageView
                    android:id="@+id/btn_save_loop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Save loop"
                    android:src="@drawable/ic_add"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_add"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Loop list -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_loop_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/layout_loop_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_xl">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Loop"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center"
                        android:text="@string/no_saved_loops"
                        android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                        android:textColor="@color/colorOnSurfaceVariant" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- ══════ PANEL: NOTES (Saved Notes + Add Note FAB) ════════════════ -->
        <LinearLayout
            android:id="@+id/panel_notes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Add note form — compact single-line input (at top, always visible) -->
            <LinearLayout
                android:id="@+id/layout_add_note_form"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:background="@drawable/bg_compact_form">

                <!-- Note text input -->
                <EditText
                    android:id="@+id/et_note_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Write a note..."
                    android:textColor="@color/colorOnSurface"
                    android:textColorHint="@color/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <!-- Save/Add icon -->
                <ImageView
                    android:id="@+id/btn_save_note"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Save note"
                    android:src="@drawable/ic_add"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_add"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Notes list with spacing between cards -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_notes_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/layout_notes_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_xl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Notes"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center"
                        android:text="No saved notes yet."
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                        android:textColor="@color/colorOnSurfaceVariant" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TAB NAVIGATION PILL (52dp) — Compact pill-shaped tab bar
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_tab_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_nav_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_sm"
        android:background="@color/colorBackground">

        <!-- Tab: Clean -->
        <LinearLayout
            android:id="@+id/tab_clean_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_clean"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorPrimary" />

        </LinearLayout>

        <!-- Divider between Clean and Talk -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Talk -->
        <LinearLayout
            android:id="@+id/tab_talk_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_talk"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Divider between Talk and Loop -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Loop -->
        <LinearLayout
            android:id="@+id/tab_loop_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_loop"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Divider between Loop and Notes -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Notes -->
        <LinearLayout
            android:id="@+id/tab_notes_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_notes"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PLAYER FOOTER CARD (180dp) — Now Playing controls
         ═══════════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorPlayerBar"
        app:strokeColor="@color/colorOutlineVariant"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Track Title -->
            <TextView
                android:id="@+id/tv_now_playing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Horizon.TitleMedium"
                android:textColor="@color/colorOnSurface"
                android:textStyle="bold"
                tools:text="Chapter 03" />

            <!-- Info line -->
            <TextView
                android:id="@+id/tv_player_info_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.LabelSmall"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="Mode:Clean | Loop:None | Speed:2x" />

            <!-- Seekbar with time labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    tools:text="1:24" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:maxHeight="16dp"
                    android:minHeight="16dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@android:color/transparent"
                    android:contentDescription="@string/content_desc_seek_bar" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    tools:text="3:45" />

            </LinearLayout>

            <!-- Transport Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_rewind_5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="-5s"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnSurface"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rounded_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="Play"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnPrimary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_play_pause_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_forward_5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="+5s"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnSurface"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rounded_button"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
