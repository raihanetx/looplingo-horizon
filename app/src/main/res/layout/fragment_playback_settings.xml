<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizon Loop — Now Playing Screen (v6 Tab-Based Redesign)
    Structure matches user's physical device wireframe:
      ┌──────────────────────────────────────────┐
      │  HEADER BLOCK (48px)                     │
      │  [Avatar] Track Info    [Loop] [Speed]   │
      ├──────────────────────────────────────────┤
      │  MAIN DISPLAY AREA (flex-1)              │
      │  - Clean View Panel                      │
      │  - Talk Panel (dialogue list)            │
      │  - Loop Panel (A-B controls + templates) │
      │  - Notes Panel (saved timestamps)        │
      ├──────────────────────────────────────────┤
      │  TAB NAVIGATION PILL (52px)              │
      │  [Clean] [Talk] [Loop] [Notes]           │
      ├──────────────────────────────────────────┤
      │  PLAYER FOOTER CARD (180px)              │
      │  [Track Title & Subtitle]                │
      │  [Elapsed] |I|I|I|I| [Total]             │
      │            Waveform SeekBar              │
      │  [Rewind]   [Play]   [Forward]           │
      └──────────────────────────────────────────┘
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER — profile icon + name + speed | secondary: app name + plan
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_lg">

        <!-- Profile avatar icon -->
        <ImageView
            android:id="@+id/iv_header_avatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:contentDescription="@string/content_desc_video_icon"
            android:scaleType="centerInside"
            android:background="@drawable/bg_profile_avatar"
            app:srcCompat="@drawable/ic_person"
            app:tint="@color/colorOnPrimary"
            android:clickable="true"
            android:focusable="true" />

        <!-- Name + Plan column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raihan"
                android:textAppearance="@style/TextAppearance.Horizon.TitleSmall"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/tv_header_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horizon loop | pro plan"
                android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Options button (double arrow) — triggers subtitle generation / options -->
        <ImageView
            android:id="@+id/iv_send_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:padding="@dimen/space_xs"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_double_arrow"
            app:tint="@color/colorOnSurface" />

        <!-- Speed indicator (no background, plain text) -->
        <TextView
            android:id="@+id/tv_header_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textAppearance="@style/TextAppearance.Horizon.TitleSmall"
            android:textColor="@color/colorOnSurface"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN DISPLAY AREA (flex-1) — Switchable panels via tab navigation
         ═══════════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/layout_main_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ══════ PANEL: CLEAN VIEW ══════ -->
        <!-- Minimal view — shows current track info, waveform visualization, no clutter -->
        <LinearLayout
            android:id="@+id/panel_clean"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_xl"
            android:visibility="visible">

            <!-- Large option icon (hidden when subtitles shown) -->
            <ImageView
                android:id="@+id/iv_clean_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.3"
                android:contentDescription="@string/content_desc_video_icon"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_double_arrow"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_clean_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineMedium"
                android:textColor="@color/colorOnSurface"
                tools:text="Chapter 03" />

            <!-- English dialogue (shown when subtitles active) -->
            <TextView
                android:id="@+id/tv_clean_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorOnSurface"
                android:visibility="gone"
                tools:text="Hello, how are you today?" />

            <!-- Bangla translation (shown when subtitles active) — same size as English -->
            <TextView
                android:id="@+id/tv_clean_bangla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                tools:text="হ্যালো, আজ কেমন আছেন?" />

        </LinearLayout>

        <!-- ══════ PANEL: TALK (Dialogue List) ═══════════════════════════════ -->
        <!-- Shows only the dialogue segments list -->
        <FrameLayout
            android:id="@+id/panel_talk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dialogue_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/item_subtitle_cue" />

            <!-- Empty state for Talk panel -->
            <LinearLayout
                android:id="@+id/layout_talk_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.3"
                    android:contentDescription="Dialogue"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_talk"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/no_dialogue_yet"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

        <!-- ══════ PROGRESS OVERLAY (visible during subtitle generation) ══════ -->
        <LinearLayout
            android:id="@+id/layout_progress_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/colorBackground"
            android:paddingHorizontal="@dimen/space_xl"
            android:visibility="gone">

            <!-- Step icon -->
            <ImageView
                android:id="@+id/iv_progress_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.8"
                android:contentDescription="Progress"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_audio_track"
                app:tint="@color/colorPrimary" />

            <!-- Main step text -->
            <TextView
                android:id="@+id/tv_progress_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="Preparing..."
                android:textAppearance="@style/TextAppearance.Horizon.TitleMedium"
                android:textColor="@color/colorOnSurface" />

            <!-- Progress bar -->
            <ProgressBar
                android:id="@+id/progress_bar_generation"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/colorPrimary"
                android:progressBackgroundTint="@color/colorSurfaceVariant"
                android:indeterminate="false" />

            <!-- Sub-step detail text -->
            <TextView
                android:id="@+id/tv_progress_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text=""
                android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                android:textColor="@color/colorOnSurfaceVariant" />

            <!-- Percentage text -->
            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="0%"
                android:textAppearance="@style/TextAppearance.Horizon.HeadlineSmall"
                android:textColor="@color/colorPrimary" />

            <!-- In-app process log (scrollable, copyable) -->
            <ScrollView
                android:id="@+id/scroll_process_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@color/colorSurfaceVariant"
                android:padding="@dimen/space_sm"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_process_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Horizon.BodySmall"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>

            <!-- Copy log button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="COPY LOG"
                android:textSize="11sp"
                app:icon="@drawable/ic_content_copy"
                app:iconGravity="textStart"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <!-- ══════ PANEL: LOOP (Saved Loops + Add Loop FAB) ═════════════════ -->
        <FrameLayout
            android:id="@+id/panel_loop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Loop list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_loop_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="72dp"
                android:clipToPadding="false" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layout_loop_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_xl">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.3"
                    android:contentDescription="Loop"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tab_loop"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/no_saved_loops"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Dark FAB — slate_900 circle, 56dp -->
            <ImageView
                android:id="@+id/fab_add_loop"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Add Loop"
                android:src="@drawable/ic_add"
                android:scaleType="centerInside"
                android:background="@drawable/bg_dark_fab"
                app:tint="@color/white"
                android:clickable="true"
                android:focusable="true" />

            <!-- Add loop form — white card, 12dp corners, slate_200 border -->
            <LinearLayout
                android:id="@+id/layout_add_loop_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_note_form_card"
                android:visibility="gone">

                <!-- Loop name input -->
                <EditText
                    android:id="@+id/et_loop_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:background="@null"
                    android:hint="Loop name..."
                    android:textColor="@color/slate_900"
                    android:textColorHint="@color/slate_400"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/slate_200" />

                <!-- Start / End time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/et_loop_start"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:background="@null"
                        android:hint="Start (0:00)"
                        android:text="0:00"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_400"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:importantForAutofill="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/range_separator"
                        android:textColor="@color/slate_400"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_loop_end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="40dp"
                        android:background="@null"
                        android:hint="End"
                        android:textColor="@color/slate_900"
                        android:textColorHint="@color/slate_400"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:importantForAutofill="no" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_time_format"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp"
                    android:layout_marginBottom="8dp" />

                <!-- Loop count row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loop_count_label"
                        android:textColor="@color/slate_600"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_loop_form_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="−"
                        android:textSize="18sp"
                        android:textColor="@color/slate_600"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_loop_form_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:text="3"
                        android:textColor="@color/slate_900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_loop_form_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="@color/slate_600"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Action buttons row — right-aligned -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="12dp">

                    <!-- Cancel button -->
                    <TextView
                        android:id="@+id/btn_cancel_loop"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Cancel"
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/slate_600"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Save Loop button -->
                    <TextView
                        android:id="@+id/btn_save_loop"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Save Loop"
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_note_button"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- ══════ PANEL: NOTES (Saved Notes + Add Note FAB) ════════════════ -->
        <FrameLayout
            android:id="@+id/panel_notes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Notes list with spacing between cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notes_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="72dp"
                android:clipToPadding="false" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/layout_notes_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingTop="80dp"
                android:text="No saved notes yet.\nClick the + button to add one."
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                android:textColor="@color/slate_400"
                android:visibility="gone" />

            <!-- Dark FAB — slate_900 circle, 56dp -->
            <ImageView
                android:id="@+id/fab_add_note"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="Add Note"
                android:src="@drawable/ic_add"
                android:scaleType="centerInside"
                android:background="@drawable/bg_dark_fab"
                app:tint="@color/white"
                android:clickable="true"
                android:focusable="true" />

            <!-- Add note form — white card, 12dp corners, slate_200 border -->
            <LinearLayout
                android:id="@+id/layout_add_note_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_note_form_card"
                android:visibility="gone">

                <!-- Auto-growing text input -->
                <EditText
                    android:id="@+id/et_note_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:maxHeight="300dp"
                    android:gravity="top"
                    android:background="@null"
                    android:hint="Write a note..."
                    android:textColor="@color/slate_900"
                    android:textColorHint="@color/slate_400"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5"
                    android:inputType="textMultiLine|textCapSentences"
                    android:importantForAutofill="no" />

                <!-- Action buttons row — right-aligned -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="12dp">

                    <!-- Cancel button -->
                    <TextView
                        android:id="@+id/btn_cancel_note"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Cancel"
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/slate_600"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Add Note / Save Changes button -->
                    <TextView
                        android:id="@+id/btn_save_note"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Add Note"
                        android:textSize="13sp"
                        android:textStyle="normal"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_note_button"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TAB NAVIGATION PILL (52dp) — Compact pill-shaped tab bar
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_tab_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_nav_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_sm"
        android:background="@color/colorBackground">

        <!-- Tab: Clean -->
        <LinearLayout
            android:id="@+id/tab_clean_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_clean"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorPrimary" />

        </LinearLayout>

        <!-- Divider between Clean and Talk -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Talk -->
        <LinearLayout
            android:id="@+id/tab_talk_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_talk"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Divider between Talk and Loop -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Loop -->
        <LinearLayout
            android:id="@+id/tab_loop_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_loop"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Divider between Loop and Notes -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@color/colorOutlineVariant" />

        <!-- Tab: Notes -->
        <LinearLayout
            android:id="@+id/tab_notes_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/space_xs"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_notes"
                android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                android:textColor="@color/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PLAYER FOOTER CARD (180dp) — Now Playing controls
         ═══════════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorPlayerBar"
        app:strokeColor="@color/colorOutlineVariant"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Track Title -->
            <TextView
                android:id="@+id/tv_now_playing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Horizon.TitleMedium"
                android:textColor="@color/colorOnSurface"
                android:textStyle="bold"
                tools:text="Chapter 03" />

            <!-- Info line -->
            <TextView
                android:id="@+id/tv_player_info_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Horizon.LabelSmall"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="Mode:Clean | Loop:None | Speed:2x" />

            <!-- Seekbar with time labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_current_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    tools:text="1:24" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:maxHeight="16dp"
                    android:minHeight="16dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@android:color/transparent"
                    android:contentDescription="@string/content_desc_seek_bar" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Horizon.BodyMedium"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    tools:text="3:45" />

            </LinearLayout>

            <!-- Transport Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_rewind_5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="-5s"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnSurface"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rounded_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="Play"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnPrimary"
                    android:textStyle="bold"
                    android:background="@drawable/bg_play_pause_button"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_forward_5"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="+5s"
                    android:textAppearance="@style/TextAppearance.Horizon.LabelMedium"
                    android:textColor="@color/colorOnSurface"
                    android:textStyle="bold"
                    android:background="@drawable/bg_rounded_button"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
