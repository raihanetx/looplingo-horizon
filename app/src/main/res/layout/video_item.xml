<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="20dp"
    android:background="@drawable/bg_glass_card"
    android:foreground="?attr/selectableItemBackground">

    <!-- Left border indicator for playing state -->
    <View
        android:id="@+id/view_playing_indicator"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="11dp"
        android:background="@android:color/transparent" />

    <!-- Headphone icon (no background, bigger) -->
    <ImageView
        android:id="@+id/iv_video_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/content_desc_video_icon"
        android:scaleType="centerInside"
        android:src="@drawable/ic_audio_track"
        android:tint="@color/colorPrimary" />

    <!-- Text content (title + info line) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            tools:text="Chapter 03 - Introducing Yourself" />

        <!-- Info line: file size | subtitle status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- File size -->
            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="24.5 MB" />

            <!-- Divider line -->
            <View
                android:id="@+id/divider_subtitle"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/colorOutlineVariant"
                android:visibility="gone" />

            <!-- Subtitle status: "Generated" or "Not generated" -->
            <TextView
                android:id="@+id/tv_subtitle_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                tools:text="Generated" />

            <!-- Loading indicator for subtitle check -->
            <ProgressBar
                android:id="@+id/progress_subtitle_check"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                android:indeterminate="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Duration on the right side, vertically centered -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textStyle="bold"
            tools:text="05:32" />

    </LinearLayout>

    <!-- Loop mode badge -->
    <TextView
        android:id="@+id/tv_loop_badge"
        android:layout_width="@dimen/video_item_badge_size"
        android:layout_height="@dimen/video_item_badge_size"
        android:layout_marginStart="6dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:textColor="@color/colorOnPrimary"
        android:textSize="10sp"
        android:visibility="gone"
        android:contentDescription="@string/content_desc_loop_badge"
        tools:text="∞" />

</LinearLayout>
