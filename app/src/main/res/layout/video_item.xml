<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp"
    android:background="@drawable/bg_glass_card"
    android:foreground="?attr/selectableItemBackground">

    <!-- Audio track icon -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/iv_video_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/content_desc_video_icon"
            android:scaleType="centerInside"
            android:src="@drawable/ic_audio_track"
            android:tint="@color/colorPrimary" />

    </FrameLayout>

    <!-- Text content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            tools:text="Chapter 03 - Introducing Yourself" />

        <!-- Info line: size | duration | subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- File size -->
            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="24.5 MB" />

            <!-- Divider -->
            <View
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/colorOutlineVariant" />

            <!-- Duration -->
            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorOnSurfaceVariant"
                tools:text="05:32" />

            <!-- Divider (subtitle) -->
            <View
                android:id="@+id/divider_subtitle"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="6dp"
                android:background="@color/colorOutlineVariant"
                android:visibility="gone" />

            <!-- Subtitle status -->
            <TextView
                android:id="@+id/tv_subtitle_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"
                tools:text="Subtitles" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loop mode badge -->
    <TextView
        android:id="@+id/tv_loop_badge"
        android:layout_width="@dimen/video_item_badge_size"
        android:layout_height="@dimen/video_item_badge_size"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:textColor="@color/colorOnPrimary"
        android:textSize="10sp"
        android:visibility="gone"
        android:contentDescription="@string/content_desc_loop_badge"
        tools:text="∞" />

</LinearLayout>
