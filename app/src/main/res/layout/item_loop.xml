<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_loop_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_note_card">

    <!-- Loop name + count -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_loop_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            tools:text="Practice Greeting" />

        <TextView
            android:id="@+id/tv_loop_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            tools:text="3 loops" />

    </LinearLayout>

    <!-- Edit + Delete buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Edit button -->
        <ImageView
            android:id="@+id/iv_loop_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerInside"
            android:contentDescription="Edit loop"
            android:src="@drawable/ic_edit"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Delete button -->
        <ImageView
            android:id="@+id/iv_loop_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:scaleType="centerInside"
            android:contentDescription="Delete loop"
            android:src="@drawable/ic_delete"
            android:tint="@color/colorOnSurfaceVariant"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
